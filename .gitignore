# ==========================================
# Cache
# ==========================================
.pytest_cache/
.mypy_cache/
# Project-local pytest basetemp (Sprint 13.8: keeps test temp state
# in-repo, away from the machine-wide ``pytest-of-<user>`` tree that a
# broken ``pytest-current`` junction makes Windows pytest trip on at
# session end).
.pytest_tmp/
/.ptmp_*/

# Benchmark output artifacts (generated; never committed)
/benchmark-*.json
benchmarks/results/

# One-off scratch scripts
scripts/_tmp_*.py

# Runtime state (generated by the engine; never committed)
data/state/worker_metrics.json
data/state/nepse_calendar_history.json
# Release manifest (build-time artifact with timestamp/revision; never committed)
data/state/release_manifest.json

# ==========================================
# Market Data
# ==========================================
data/raw/*.csv

# ==========================================
# OS Files
# ==========================================
.DS_Store
Thumbs.db


