# =====================================================================
# NEPSE Quant Engine — Environment Variables
# =====================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables have safe defaults — only TELEGRAM_TOKEN is required
# if you plan to use the Telegram bot.
# =====================================================================

# ── Telegram Bot ──────────────────────────────────────────────────
# Token from @BotFather on Telegram.
# Required only if you use the Telegram bot.
TELEGRAM_TOKEN=

# ── API Server ────────────────────────────────────────────────────
# Base URL for the FastAPI backend.  In Docker Compose this is
# auto-configured; when running natively set it to your server URL.
API_BASE_URL=http://127.0.0.1:8000

# ── NEPSE Data Sources ────────────────────────────────────────────
# The DataService tries these in order.  Leave empty ("") to skip a
# particular source.  The defaults point at community-maintained APIs.
NEPSE_SCRAPER_URL=https://nepseapi.surajrimal.dev/api/v1
NEPSE_DATA_API_URL=
NEPSE_CLIENT_URL=https://shubhamnpk.github.io/yonepse/data
NEPALSTOCK_OFFICIAL_URL=

# ── Data Directory ────────────────────────────────────────────────
# Where the engine looks for local CSV files (price history).
# Relative paths are resolved from the project root.
DATA_DIRECTORY=data/raw

# ── Cache Settings ────────────────────────────────────────────────
CACHE_MEMORY_TTL=60         # seconds before in-memory cache expires
CACHE_DISK_TTL=600          # seconds before on-disk cache expires
CACHE_DISK_DIR=             # optional custom cache directory
CACHE_REFRESH_INTERVAL=60   # background refresh interval (seconds)

# ── WebSocket ─────────────────────────────────────────────────────
WEBSOCKET_ENABLED=false
WEBSOCKET_URL=wss://nepseapi.surajrimal.dev/ws

# ── Rate Limiter ──────────────────────────────────────────────────
RATE_LIMIT=10               # max requests per second
API_TIMEOUT=15              # HTTP request timeout (seconds)
RETRY_COUNT=3               # retries on transient failures
BACKOFF_BASE=1.0            # exponential backoff base (seconds)

# ── Performance Monitoring ────────────────────────────────────────
ENABLE_PERFORMANCE_MONITORING=false

# ── Health Check ──────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=60

# ── Docker / Ports ────────────────────────────────────────────────
STREAMLIT_PORT=8501
API_PORT=8000

# ── Streamlit Config ──────────────────────────────────────────────
# Uncomment to override Streamlit defaults
# STREAMLIT_SERVER_MAX_UPLOAD_SIZE=50
# STREAMLIT_SERVER_MAX_MESSAGE_SIZE=200
